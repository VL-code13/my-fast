# Виртуальное окружение и Python-специфичные папки
.venv/
venv/

# Кэш интерпретатора и скомпилированные файлы
__pycache__/
*.pyc

# Артефакты тестирования и покрытия кода
.pytest_cache/
htmlcov/

# Файлы окружения (конфиденциальные данные: пароли, ключи)
.env
*.env.local

# Логи и временные файлы
*.log
*.tmp

# Директории, создаваемые средами разработки
.idea/
.vscode/
*.swp
*.swo

# Файлы и папки, специфичные для инструментов
*.db
*.sqlite

# Артефакты упаковки
dist/
*.egg-info/

# Контрольные точки Jupyter Notebook (если работаете с интерактивным кодом)
.ipynb_checkpoints/

# Локальные дампы и кэш инструментов
*.dump
.cache/

# Системные файлы (macOS .DS_Store, Windows Thumbs.db)
.DS_Store
Thumbs.db
