# ==============================================================================
# Makefile для проекта my-fastapi-app
#
# Запуск: make <цель>
# Справка: make help
# ==============================================================================

# .DEFAULT_GOAL — цель по умолчанию, если запустить просто `make`.
.DEFAULT_GOAL := help

# .PHONY — объявляет цели, которые НЕ являются файлами.
# Без этого make может решить: "файл check уже существует, пропустим".
# Всегда объявляй .PHONY для команд-действий.
.PHONY: help sync lint format format-check typecheck check test test-cov clean \
        migrate revision downgrade

# ─────────────────────────────────────────────────────────────────────────────
# HELP — самоописательная справка
# ─────────────────────────────────────────────────────────────────────────────
help: ## Показать список доступных команд
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}'

# ─────────────────────────────────────────────────────────────────────────────
# SYNC — установка/синхронизация зависимостей
# ─────────────────────────────────────────────────────────────────────────────
sync: ## Синхронизировать окружение с uv.lock
	uv sync

# ─────────────────────────────────────────────────────────────────────────────
# LINT — проверка кода линтером (без изменений)
# ─────────────────────────────────────────────────────────────────────────────
lint: ## Запустить ruff check (только проверка, без исправлений)
	uv run ruff check src/

# ─────────────────────────────────────────────────────────────────────────────
# FORMAT — автоформатирование кода
# ─────────────────────────────────────────────────────────────────────────────
format: ## Автоматически отформатировать код через ruff
	uv run ruff format src/
	uv run ruff check --fix src/

# ─────────────────────────────────────────────────────────────────────────────
# FORMAT-CHECK — проверка форматирования (без изменений)
# ─────────────────────────────────────────────────────────────────────────────
format-check: ## Проверить форматирование без изменений
	uv run ruff format --check src/

# ─────────────────────────────────────────────────────────────────────────────
# TYPECHECK — статическая проверка типов
# ─────────────────────────────────────────────────────────────────────────────
typecheck: ## Запустить mypy (проверка типов)
	uv run mypy src/

# ─────────────────────────────────────────────────────────────────────────────
# CHECK — полная проверка качества кода (главная цель)
# ─────────────────────────────────────────────────────────────────────────────
check: lint format-check typecheck ## Запустить все проверки: lint + format-check + typecheck
	@echo ""
	@echo "✅ Все проверки пройдены успешно!"

# ─────────────────────────────────────────────────────────────────────────────
# TEST — запуск тестов
# ─────────────────────────────────────────────────────────────────────────────
test: ## Запустить тесты
	uv run pytest tests/ -v

test-cov: ## Запустить тесты с покрытием
	uv run pytest tests/ -v --cov=src --cov-report=term-missing --cov-report=html

# ─────────────────────────────────────────────────────────────────────────────
# MIGRATE — применить все миграции
# ─────────────────────────────────────────────────────────────────────────────
migrate: ## Применить все миграции (alembic upgrade head)
	uv run alembic upgrade head

# ─────────────────────────────────────────────────────────────────────────────
# REVISION — создать миграцию (автогенерация)
# ─────────────────────────────────────────────────────────────────────────────
revision: ## Создать миграцию: make revision m="описание"
	@if [ -z "$(m)" ]; then \
		echo "❌ Ошибка: передайте сообщение через m=\"...\""; \
		echo "Пример: make revision m=\"add description to items\""; \
		exit 1; \
	fi
	uv run alembic revision --autogenerate -m "$(m)"

# ─────────────────────────────────────────────────────────────────────────────
# DOWNGRADE — откатить одну миграцию
# ─────────────────────────────────────────────────────────────────────────────
downgrade: ## Откатить одну миграцию (alembic downgrade -1)
	uv run alembic downgrade -1

# ─────────────────────────────────────────────────────────────────────────────
# CLEAN — очистка временных файлов
# ─────────────────────────────────────────────────────────────────────────────
clean: ## Удалить кэши и временные файлы
	rm -rf .pytest_cache .mypy_cache .ruff_cache htmlcov .coverage
	find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
	@echo "🧹 Кэши очищены."